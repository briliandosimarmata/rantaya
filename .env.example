APP_ENV=development
API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://ruang:ruang_local@localhost:5432/ruang?sslmode=disable
APP_URL=http://localhost:5173
# Optional additional exact origins, separated by commas; no wildcard.
# APP_URL is always allowed. Add localhost here when APP_URL uses a LAN IP.
APP_ALLOWED_ORIGINS=
# Set HOST=0.0.0.0 and APP_URL=http://<LAN-IP>:5173 for access over local Wi-Fi.
HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:8080
UPLOAD_DIR=./var/uploads
DEMO_LOGIN=true
SEED_DEMO=true
HOLD_MINUTES=30
# Optional: Google OAuth Web Application credentials; never put secrets in PUBLIC_ vars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
