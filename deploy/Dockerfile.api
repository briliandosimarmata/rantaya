FROM golang:1.25-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -o /out/ruang-api ./cmd/api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -g 10001 rantaya \
    && adduser -D -u 10001 -G rantaya rantaya \
    && mkdir -p /data/uploads \
    && chown -R rantaya:rantaya /data
COPY --from=build /out/ruang-api /usr/local/bin/ruang-api
USER rantaya
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/ruang-api"]
